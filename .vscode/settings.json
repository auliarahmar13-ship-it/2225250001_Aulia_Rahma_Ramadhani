{
  "python.analysis.extraPaths": ["./python"],
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": ["-v", "-s", "./python/tests", "-p", "test_*.py"],
  "python.terminal.activateEnvironment": true,
  "files.associations": { "*.webmanifest": "json" },
  "files.encoding": "utf8",
  "editor.tabSize": 2,
  "[python]": { "editor.tabSize": 4 },
  "terminal.integrated.env.windows": { "PYTHONIOENCODING": "utf-8" }
}
